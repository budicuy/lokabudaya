generator client {
    provider = "prisma-client"
    output   = "./generated"
}

datasource db {
    provider = "postgresql"
}

model Place {
    id            Int     @id @default(autoincrement())
    name          String
    category      String
    location      String
    description   String
    visitors      String
    image         String
    coordinates   Float[]
    relatedPlaces Int[]

    events  Event[]
    reviews Review[]
}

model Event {
    id          Int    @id @default(autoincrement())
    title       String
    date        String
    description String
    placeId     Int
    place       Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model Review {
    id         Int      @id @default(autoincrement())
    userId     Int
    user       String
    avatar     String
    date       String
    visitCount Int
    content    String
    rating     Int
    images     String[]

    placeId Int
    place   Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model User {
    id        Int      @id @default(autoincrement())
    email     String   @unique
    name      String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

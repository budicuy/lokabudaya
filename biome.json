{
	"$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
	"assist": {"actions": {"source": {"organizeImports": "off"}}},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!node_modules", "!.next", "!dist", "!build", "!prisma/generated/"]
	},
	"formatter": {
		"bracketSameLine": true,
		"bracketSpacing": false,
		"enabled": true,
		"expand": "never",
		"formatWithErrors": true,
		"indentStyle": "tab",
		"indentWidth": 1,
		"lineWidth": 120
	},
	"linter": {
		"domains": {"next": "recommended", "react": "recommended"},
		"enabled": true,
		"rules": {"recommended": true, "suspicious": {"noUnknownAtRules": "off"}}
	},
	"vcs": {"clientKind": "git", "enabled": true, "useIgnoreFile": true}
}
